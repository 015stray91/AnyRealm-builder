To build the underlying engine logic yourself, you will write a clean C or Python execution layer. This script grabs the raw model file, sets up the memory buffer, forces the model to choose between debos or mkosi execution branches, and runs terminal tasks natively.
Create your master execution script (~/.local/bin/anyrealm-core):
python
#!/usr/bin/env python3
import sys
import os
import subprocess
import json

# Minimal logic wrapper to load raw model weights without third-party frameworks
try:
    from llama_cpp import Llama
except ImportError:
    print("Run: pip install llama-cpp-python")
    sys.exit(1)

# 1. Map the raw weight paths on your NVMe storage
MODEL_PATH = os.path.expanduser("~/anyrealm-brain/weights/qwen2.5-coder-7b-instruct-q4_k_m.gguf")

# 2. Set up the deterministic system logic matrices
DEBOS_SYSTEM_PROMPT = "You are the debos binary instance. Output ONLY raw terminal commands, recipe layers, or rootfs patches. Zero chat. Stop at [DONE]."
MKOSI_SYSTEM_PROMPT = "You are the mkosi assembly instance. Output ONLY declarative configuration manifests or split-ramdisk header arrays. Zero chat. Stop at [DONE]."

def run_engine(identity_mode, user_task):
    # Select the precise structural prompt logic based on your split workload choice
    system_prompt = DEBOS_SYSTEM_PROMPT if identity_mode == "debos" else MKOSI_SYSTEM_PROMPT
    
    # Initialize the model directly into your 16GB combined ZSTD zRAM pool
    llm = Llama(model_path=MODEL_PATH, n_ctx=2048, temperature=0.0, top_p=0.9)
    
    # Format the strict input array payload
    prompt_payload = f"<|im_start|>system\n{system_prompt}<|im_end|>\n<|im_start|>user\n{user_task}<|im_end|>\n<|im_start|>assistant\n"
    
    # Execute the raw token path inference pass off the top
    response = llm(prompt_payload, max_tokens=512, stop=["[DONE]", "<|im_end|>"])
    output_text = response["choices"][0]["text"].strip()
    
    return output_text

if __name__ == "__main__":
    if len(sys.argv) < 3:
        print("Usage: anyrealm-core [debos|mkosi] 'your task or recipe configuration context'")
        sys.exit(1)
        
    mode = sys.argv[1].lower()
    task = sys.argv[2]
    
    # Execute the loop
    result = run_engine(mode, task)
    print(result)
Use code with caution.
